<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" version="24.7.17"><diagram id="05-secuencia-timeout-core" name="05 · Secuencia del timeout del core"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1372" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="El caso crítico: el BUS no responde a tiempo — la orden pudo ejecutarse. Nunca 504; el pago existe en PENDING y se resuelve por consulta de referencia" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Aliado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Servicio de Pagos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Adaptador SOAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c6" value="BUS (SOAP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Reconciliador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c8" value="POST /payments  Idempotency-Key: K" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="150" as="sourcePoint"/><mxPoint x="395" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="registro de idempotencia: K → EN_CURSO (reserva)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="245" y="194" width="300" height="44" as="geometry"/></mxCell><mxCell id="c10" value="debitar(…)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="254" as="sourcePoint"/><mxPoint x="645" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="DebitarCuenta(idTransaccion = T = h(client_id, K))" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="298" as="sourcePoint"/><mxPoint x="895" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="el core aplica el débito…&lt;br&gt;pero la respuesta se pierde / tarda más que el presupuesto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="342" width="300" height="48" as="geometry"/></mxCell><mxCell id="c13" value="⏱ timeout de lectura (350 ms) — NO se reintenta:&lt;br&gt;una orden enviada jamás se reenvía" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="495" y="406" width="300" height="48" as="geometry"/></mxCell><mxCell id="c14" value="resultado DESCONOCIDO (no 'falló')" style="html=1;endArrow=open;endFill=0;strokeColor=#B85450;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="470" as="sourcePoint"/><mxPoint x="395" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="Payment {status: PENDING, statusReason: CORE_TIMEOUT} · persistir&lt;br&gt;registro de idempotencia: K → respuesta 201 PENDING&lt;br&gt;programar consulta(T)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="205" y="514" width="380" height="64" as="geometry"/></mxCell><mxCell id="c16" value="201 Created  {status: PENDING, statusReason.code: CORE_TIMEOUT,&lt;br&gt;message: 'consulta GET /payments/{id} o espera el evento; no reintentes el POST'}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="608" as="sourcePoint"/><mxPoint x="145" y="608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="Si el aliado reintenta el POST con la misma clave K" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="900" height="20" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#