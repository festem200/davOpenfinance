4" value="ConsultarTransaccion(idTransaccion = T)   ← por el id de la FACHADA, no del core" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="896" as="sourcePoint"/><mxPoint x="895" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="existe=true · APLICADA · idTransaccionCore · fechaHoraAplicacion" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="940" as="sourcePoint"/><mxPoint x="645" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="APLICADA" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="984" as="sourcePoint"/><mxPoint x="1145" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="transición PENDING → SETTLED · settlement.reference" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="1028" as="sourcePoint"/><mxPoint x="395" y="1028" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="webhook payment.settled  (+ feed /events)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#9673A6;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="1072" as="sourcePoint"/><mxPoint x="145" y="1072" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="Alternativas de la consulta" style="text;html=1;align=left;ver