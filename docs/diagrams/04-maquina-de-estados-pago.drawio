Cell id="c19" value="vence sin captura" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="riel liquida&lt;br&gt;(on-us · ACH · adquirencia)" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="POST /refunds (parcial)" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Σ refunds =&lt;br&gt;capturado" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="POST /refunds (total)" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="codigoRetorno ≠ 00&lt;br&gt;(fondos, bloqueo, cupo, límite)" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="error técnico CONFIRMADO" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="⟲ timeout del core → sigue PENDING&lt;br&gt;statusReason CORE_TIMEOUT&lt;br&gt;ConsultarTransaccion cada 30 s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="280" height="60" as="geometry"/></mxCell><mxCell id="c27" value="⟲ POST /captures (parcial): sigue AUTHORIZED,&lt;br&gt;capturedAmount crece" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="225" width="240" height="44" as="geometry"/></mxCell><mxCell id="c28" value="⟲ más devoluciones parciales" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="680" width="190" height="32" as="geometry"/></mxCell><mxCell id="c29" value="FAILED solo cuando ConsultarTransaccion&lt;br&gt;responde existe=false tras la ventana del core" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="680" width="310" height="44" as="geometry"/></mxCell><mxCell id="c30" value="Terminales sin dinero movido: REJECTED · CANCELLED · EXPIRED · FAILED — Terminales con dinero movido: SETTLED · REFUNDED (el pago no desaparece: se devuelve)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c31" value="Transición inválida (p. ej. capturar un CANCELLED) → 409 con el estado vigente. Cada transición emite un evento (payment.*) al feed y a los webhooks. Recurrente (RECURRING): cada cobro de la serie es un Payment independiente con esta misma máquina; el consentimiento controla los topes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="845" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>