<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" version="24.7.17"><diagram id="08-secuencia-plano-de-confianza" name="08 · Secuencia del plano de confianza"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Plano de confianza de punta a punta — cómo las dos entidades llegan a confiar una en la otra, y cómo se re-verifica en cada llamada" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Aliado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c4" value="API Gateway (mTLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c5" value="AS FAPI 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Servicio de Pagos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c7" value="BUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c8" value="A · Alta — una sola vez (descubrimiento + fuera de línea + /register)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="900" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="174" as="sourcePoint"/><mxPoint x="1230" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="A0. GET /.well-known/openid-configuration   (pública, sin certificado ni token)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="206" as="sourcePoint"/><mxPoint x="645" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="200  {registration_endpoint, token_endpoint, par, jwks_uri, require_pushed_authorization_requests: true,&lt;br&gt;tls_client_certificate_bound_access_tokens: true, algoritmos PS256/ES256, scopes_supported}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="264" as="sourcePoint"/><mxPoint x="145" y="264" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="El aliado configura UNA sola URL y descubre el resto; aquí ve las reglas de FAPI 2.0 antes de llamar a nada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="135" y="308" width="560" height="40" as="geometry"/></mxCell><mxCell id="c13" value="El aliado obtiene un certificado digital de una CA reconocida (Ley 527 de 1999)&lt;br&gt;y genera su par de llaves; publica la pública en su jwks_uri" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="135" y="364" width="560" height="64" as="geometry"/></mxCell><mxCell id="c14" value="La entidad hace la debida diligencia (CE 004/2024 num. 6.2: RNBD, ISO 27001/NIST/ASVS,&lt;br&gt;PCI-DSS si toca tarjeta, SARLAFT) y emite un Software Statement firmado&lt;br&gt;con la huella (x5t#S256) del certificado autorizado, exp corto y jti único" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="635" y="444" width="620" height="80" as="geometry"/></mxCell><mxCell id="c15" value="A1. POST /register  (conexión mTLS con SU certificado)&lt;br&gt;{software_statement, jwks_uri, redirect_uris, scopes solicitados}" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="554" as="sourcePoint"/><mxPoint x="395" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="cert válido: cadena · vigencia · CRL/OCSP · CA Ley 527" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="598" as="sourcePoint"/><mxPoint x="645" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="verifica firma del SSA · huella del SSA == huella del cert de la conexión&lt;br&gt;· jti no usado · scopes ⊆ aprobados en el alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="435" y="642" width="420" height="48" as="geometry"/></mxCell><mxCell id="c18" value="201  {client_id, scopes concedidos}   ← el 'carné' del aliado" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="706" as="sourcePoint"/><mxPoint x="145" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="B · Obtener una ficha de turno (token) — sin titular: client_credentials" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="748" width="900" height="20" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="774" as="sourcePoint"/><mxPoint x="1230" y="774" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="B1. POST /token  (mTLS)&lt;br&gt;grant_type=client_credentials · scope=connection:test · client_assertion=JWT PS256 firmado con SU llave privada" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="820" as="sourcePoint"/><mxPoint x="395" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="cert ↔ client_id registrado" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="864" as="sourcePoint"/><mxPoint x="645" y="864" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="verifica client_assertion contra el jwks_uri del aliado (aud = issuer exacto)&lt;br&gt;· solo scopes que NO tocan dinero ni datos del titular&lt;br&gt;· emite JWT PS256 con cnf.x5t#S256 = huella del cert · vida ≤ 10 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="385" y="908" width="520" height="64" as="geometry"/></mxCell><mxCell id="c24" value="200  {access_token (vinculado al certificado), expires_in: 600}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="988" as="sourcePoint"/><mxPoint x="145" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="C · Probar la conexión antes de mover dinero" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="900" height="20" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1056" as="sourcePoint"/><mxPoint x="1230" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="C1. GET /connection-test   Authorization: Bearer &lt;token&gt;   (misma conexión mTLS)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="1088" as="sourcePoint"/><mxPoint x="395" y="1088" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="① TLS mutuo  ② cert ↔ client_id  ③ firma PS256 contra /jwks, iss/aud, exp, revocación&lt;br&gt;④ cnf.x5t#S256 del token == huella del cert de ESTA conexión  ⑤ scope connection:test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="385" y="1132" width="620" height="64" as="geometry"/></mxCell><mxCell id="c29" value="petición verificada + client_id" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="1212" as="sourcePoint"/><mxPoint x="895" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="200  {clientId, certificateThumbprint, tokenBoundToCertificate: true, effectiveScopes}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1256" as="sourcePoint"/><mxPoint x="145" y="1256" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Si tokenBoundToCertificate = false → el token se pidió con otro certificado; el aliado se autodiagnostica sin abrir un ticket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="135" y="1300" width="460" height="40" as="geometry"/></mxCell><mxCell id="c32" value="D · Cada llamada de negocio — la verificación se repite completa (aquí con titular: authorization_code, ver diagrama 03)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1354" width="900" height="20" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1380" as="sourcePoint"/><mxPoint x="1230" y="1380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="D1. POST /payments  Bearer &lt;token con authorization_details&gt; · Idempotency-Key · Signature" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="1412" as="sourcePoint"/><mxPoint x="395" y="1412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="①–⑤ igual que en C (mTLS, cert↔client_id, firma del token, vínculo cnf, scope payments:initiate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="385" y="1456" width="520" height="36" as="geometry"/></mxCell><mxCell id="c36" value="petición verificada + client_id + traceparent" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="1508" as="sourcePoint"/><mxPoint x="895" y="1508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="⑥ authorization_details del token == consentId · monto · beneficiario · instrumento del request&lt;br&gt;   consentimiento AUTHORISED, vigente, no revocado&lt;br&gt;⑦ firma RFC 9421 del mensaje válida (created ≤ 5 min) · Idempotency-Key en el ámbito del client_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="615" y="1552" width="560" height="64" as="geometry"/></mxCell><mxCell id="c38" value="⑧ ValidarTitularidad(titular del consentimiento, producto)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1632" as="sourcePoint"/><mxPoint x="1145" y="1632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="esTitular=true · ACTIVO" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="1676" as="sourcePoint"/><mxPoint x="895" y="1676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="→ recién aquí se mueve dinero (diagrama 02). Cualquier verificación fallida corta antes:&lt;br&gt;①→conexión rechazada · ②③④→401 · ⑤⑥→403 · ⑦→400/422 · ⑧→REJECTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="615" y="1720" width="560" height="48" as="geometry"/></mxCell><mxCell id="c41" value="201 Created  {paymentId, …}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1784" as="sourcePoint"/><mxPoint x="145" y="1784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Todo el recorrido (A–D) queda en el log de auditoría de 5 años con origen · momento · usuario · información circulada · estado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="385" y="1828" width="720" height="36" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#BBBBBB;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="130" as="sourcePoint"/><mxPoint x="145" y="1890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#BBBBBB;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="130" as="sourcePoint"/><mxPoint x="395" y="1890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#BBBBBB;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="130" as="sourcePoint"/><mxPoint x="645" y="1890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#BBBBBB;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="130" as="sourcePoint"/><mxPoint x="895" y="1890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#BBBBBB;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="130" as="sourcePoint"/><mxPoint x="1145" y="1890" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>