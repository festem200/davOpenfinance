<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" version="24.7.17"><diagram id="03-secuencia-doble-consentimiento" name="03 · Secuencia del doble consentimiento"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1416" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Doble consentimiento colombiano (arts. 2.35.8.3.2 y 2.35.8.3.3) sobre FAPI 2.0 — flujo REDIRECT; la variante CIBA se anota al final" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Titular" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Aliado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c5" value="AS FAPI 2.0 (entidad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Servicio de Pagos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c7" value="BUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="170" height="50" as="geometry"/></mxCell><mxCell id="c8" value="0. GET /.well-known/openid-configuration   (una vez, pública: descubre /par, /authorize, /token, /jwks y las reglas FAPI 2.0)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="150" as="sourcePoint"/><mxPoint x="645" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="200  {URLs, require_pushed_authorization_requests: true, algoritmos PS256/ES256, scopes}" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="194" as="sourcePoint"/><mxPoint x="395" y="194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="1. Quiere pagar la orden 48213" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="238" as="sourcePoint"/><mxPoint x="395" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="2. POST /payment-consents  {SINGLE, SAVINGS_ACCOUNT, 150000.00, creditor,&lt;br&gt;purpose, expiresAt}   (token client_credentials no basta: consents:write)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="296" as="sourcePoint"/><mxPoint x="895" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="201 · consentId · authorization.authorizationDetails (RFC 9396)" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="340" as="sourcePoint"/><mxPoint x="395" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="AUTORIZACIÓN (art. 2.35.8.3.2): el aliado muestra al titular&lt;br&gt;quién es (razón social, domicilio), qué, para qué, cuánto y hasta cuándo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="384" width="360" height="52" as="geometry"/></mxCell><mxCell id="c14" value="3. Acepta" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="452" as="sourcePoint"/><mxPoint x="395" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="4. POST /par  (private_key_jwt · PKCE S256)&lt;br&gt;scope + authorization_details = {consentId, monto, beneficiario}" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="510" as="sourcePoint"/><mxPoint x="645" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="201 · request_uri (≤ 60 s, un solo uso)" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="554" as="sourcePoint"/><mxPoint x="395" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="5. Redirección a /authorize?client_id&amp;request_uri" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="598" as="sourcePoint"/><mxPoint x="145" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="6. /authorize?request_uri" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="642" as="sourcePoint"/><mxPoint x="645" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="AUTENTICACIÓN FUERTE (art. 2.35.8.3.4) + CONFIRMACIÓN (art. 2.35.8.3.3)&lt;br&gt;en UNA sola pantalla: muestra exactamente el consentimiento recibido en el PAR,&lt;br&gt;el titular ELIGE su producto y AUTORIZA o DENIEGA. Sin dark patterns (Cap. IX num. 7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999966;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="686" width="440" height="70" as="geometry"/></mxCell><mxCell id="c20" value="7. ValidarTitularidad(titular, producto elegido)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="772" as="sourcePoint"/><mxPoint x="1145" y="772" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="esTitular · ACTIVO · numeroEnmascarado" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="816" as="sourcePoint"/><mxPoint x="645" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="8. consentimiento AUTHORISED · instrument {productReference opaco, ****4821}" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="860" as="sourcePoint"/><mxPoint x="895" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="9. 302 → redirect_uri?code&amp;iss   (code ≤ 60 s)" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="904" as="sourcePoint"/><mxPoint x="145" y="904" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="10. code" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="948" as="sourcePoint"/><mxPoint x="395" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="11. POST /token  {code, code_verifier}  (mTLS)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="992" as="sourcePoint"/><mxPoint x="645" y="992" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="200 · access_token JWT PS256 · cnf.x5t#S256 · authorization_details" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="1036" as="sourcePoint"/><mxPoint x="395" y="1036" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="12. POST /payments  {consentId, 150000.00}  → ver diagrama 02" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="1080" as="sourcePoint"/><mxPoint x="895" y="1080" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="Variante desacoplada (CIBA) — punto de venta, call center, recurrencia" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1122" width="900" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1148" as="sourcePoint"/><mxPoint x="1230" y="1148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="POST /bc-authorize  {login_hint, authorization_details, binding_message: 'K7P2'}" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="1180" as="sourcePoint"/><mxPoint x="645" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="push a la app: 'Tienda Ejemplo · 150.000 COP · código K7P2'  → autentica y confirma" style="html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="1224" as="sourcePoint"/><mxPoint x="145" y="1224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="POST /token  {grant_type: ciba, auth_req_id}   (poll cada 'interval' segundos)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeomet