<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" version="24.7.17"><diagram id="06-cadena-validacion-conexion" name="06 · Cadena de validación de la conexión"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Cadena de validación en cada llamada — ocho verificaciones en orden; la primera que falla corta. GET /connection-test devuelve el resultado de 1–5" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;① TLS mutuo&lt;/b&gt;&lt;br&gt;cadena · vigencia · CRL/OCSP&lt;br&gt;CA reconocida (Ley 527 de 1999)&lt;br&gt;suite: ECDHE-RSA-AES-GCM (1.2) o TLS 1.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="96" as="geometry"/></mxCell><mxCell id="c4" value="✗ corta con: Conexión rechazada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="194" width="260" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;② Certificado ↔ client_id&lt;/b&gt;&lt;br&gt;la huella del cert coincide con la&lt;br&gt;registrada para ese client_id (/register)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="444" y="90" width="300" height="96" as="geometry"/></mxCell><mxCell id="c6" value="✗ corta con: 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="464" y="194" width="260" height="30" as="geometry"/></mxCell><mxCell id="c7" value="✓" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;③ Token&lt;/b&gt;&lt;br&gt;firma PS256+ contra /jwks · iss/aud exactos&lt;br&gt;exp · estado de revocación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="828" y="90" width="300" height="96" as="geometry"/></mxCell><mxCell id="c9" value="✗ corta con: 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="848" y="194" width="260" height="30" as="geometry"/></mxCell><mxCell id="c10" value="✓" style="edgeStyle=none;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;④ Vínculo cert–token&lt;/b&gt;&lt;br&gt;cnf.x5t#S256 del JWT == huella del cert&lt;br&gt;de ESTA conexión (RFC 8705)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1212" y="90" width="300" height="96" as="geometry"/></mxCell><mxCell id="c12" value="✗ corta con: 401 — el token es de otro canal" style="rounded=1;whiteS