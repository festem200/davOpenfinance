<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" version="24.7.17"><diagram id="01-contexto-y-componentes" name="01 · Contexto y componentes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Contexto y componentes — la fachada REST es la única superficie que el aliado ve; el BUS SOAP nunca sale de la red interna" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Aliado / Fintech&lt;br&gt;(cliente OAuth confidencial)&lt;br&gt;&lt;i&gt;certificado mTLS · llave privada · SDK&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Titular&lt;br&gt;(cliente de la entidad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="230" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Red lógicamente separada — sistema de finanzas abiertas (CE 004/2024, 3.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;dashPattern=6 4;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="780" height="640" as="geometry"/></mxCell><mxCell id="c6" value="API Gateway / Edge&lt;br&gt;· terminación mTLS (Ley 527) · WAF&lt;br&gt;· rate limit por aliado y scope&lt;br&gt;· medición para tarifa" style="rounded=1;whi